# Nebius / NVIDIA API Configuration
# Get your API key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=your-api-key-here
# Must include the /v1 suffix - use Nebius Token Factory endpoint for Nemotron models
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model Configuration (optional - defaults shown)
# ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NANO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Analysis Configuration
# MIN_ARTIFACT_CONFIDENCE=0.6
# MIN_STRATA_SIZE=3
# FOSSIL_THRESHOLD_DAYS=180
# RUIN_COMPLEXITY_THRESHOLD=50
# MAX_FILE_SIZE_KB=500
# PARALLEL_WORKERS=4

# Logging
# LOG_LEVEL=INFO

# Web API: directory live /scan and /excavate requests may read from
# ARCHAEOLOGIST_ALLOWED_ROOT=./data