# Nebius / NVIDIA API Configuration
# Get your API key from https://integrate.api.nvidia.com
NEBIUS_API_KEY=your-api-key-here
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Configuration (optional - defaults shown)
# NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super
# NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano

# Analysis Configuration
# ANALYSIS_MIN_ARTIFACT_CONFIDENCE=0.6
# ANALYSIS_MIN_STRATA_SIZE=3
# ANALYSIS_FOSSIL_THRESHOLD_DAYS=180
# ANALYSIS_RUIN_COMPLEXITY_THRESHOLD=50
# ANALYSIS_MAX_FILE_SIZE_KB=500
# ANALYSIS_PARALLEL_WORKERS=4

# Logging
# LOG_LEVEL=INFO