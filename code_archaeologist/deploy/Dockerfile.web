# Build from the repository root:
#   docker build -f code_archaeologist/deploy/Dockerfile.web -t code-archaeologist-web .
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY code_archaeologist ./code_archaeologist
COPY site ./site
RUN pip install --no-cache-dir ".[web]"

RUN mkdir -p /app/data
ENV ARCHAEOLOGIST_ALLOWED_ROOT=/app/data
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python", "-m", "code_archaeologist.deploy.web_api"]
